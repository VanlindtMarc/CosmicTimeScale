      "name": "Première version de Microsoft Office (Macintosh)",
      "years_ago": 36.88916881529201,
      "absolute_date": "1989-06-19T00:00:00.000000",
      "description": "Office apparaît d’abord sur Macintosh comme suite intégrée rassemblant Word, Excel, PowerPoint et Mail. Cette logique de suite unifiée deviendra l’un des piliers commerciaux de Microsoft.",
      "group_name": "Microsoft"
    },
    {
      "name": "Windows 3.0",
      "years_ago": 35.966513100028486,
      "absolute_date": "1990-05-22T00:00:00.000000",
      "description": "Windows 3.0 rencontre un succès commercial majeur et crédibilise définitivement l’environnement graphique de Microsoft auprès des particuliers et des entreprises.",
      "group_name": "Microsoft"
    },
    {
      "name": "MS-DOS 5.0",
      "years_ago": 34.91244054698263,
      "absolute_date": "1991-06-11T00:00:00.000000",
      "description": "MS-DOS 5.0 est l’une des versions les plus importantes de DOS, avec de meilleures capacités mémoire et des outils devenus emblématiques comme EDIT et QBasic.",
      "group_name": "Microsoft"
    },
    {
      "name": "Windows 3.1",
      "years_ago": 34.091085310843,
      "absolute_date": "1992-04-06T00:00:00.000000",
      "description": "Windows 3.1 apporte plus de 1 000 améliorations, consolide le succès de Windows et participe à l’explosion de l’écosystème logiciel Microsoft du début des années 1990.",
      "group_name": "Microsoft"
    },
    {
      "name": "Windows for Workgroups 3.1",
      "years_ago": 33.532563750268054,
      "absolute_date": "1992-10-27T00:00:00.000000",
      "description": "Cette version ajoute des fonctions réseau natives et montre l’importance croissante du travail collaboratif et de la bureautique connectée dans la stratégie Microsoft.",
      "group_name": "Microsoft"
    },
    {
      "name": "MS-DOS 6.0",
      "years_ago": 33.11093472904971,
      "absolute_date": "1993-03-30T00:00:00.000000",
      "description": "MS-DOS 6.0 modernise la fin de vie de DOS avec compression de disque, antivirus et outils système plus complets, juste avant que Windows ne prenne définitivement le dessus.",
      "group_name": "Microsoft"
    },
    {
      "name": "Windows NT 3.1",
      "years_ago": 32.96035293575744,
      "absolute_date": "1993-05-24T00:00:00.000000",
      "description": "Windows NT 3.1 lance la branche professionnelle 32 bits de Microsoft, pensée pour la robustesse, la sécurité et l’entreprise. Cette lignée devient la base de tous les Windows modernes.",
      "group_name": "Microsoft"
    },
    {
      "name": "MS-DOS 6.22",
      "years_ago": 31.939134592157167,
      "absolute_date": "1994-06-01T00:00:00.000000",
      "description": "MS-DOS 6.22 représente l’aboutissement de la branche DOS autonome avant son absorption progressive par Windows 9x. Elle clôt pratiquement la grande époque du DOS vendu pour lui-même.",
      "group_name": "Microsoft"
    },
    {
      "name": "Office 97",
      "years_ago": 29.31079783651035,
      "absolute_date": "1997-01-16T00:00:00.000000",
      "description": "Office 97 diffuse massivement VBA, renforce l’intégration des applications et devient une référence durable dans les environnements bureautiques professionnels.",
      "group_name": "Microsoft"
    },
    {
      "name": "Windows 98",
      "years_ago": 27.873426173265997,
      "absolute_date": "1998-06-25T00:00:00.000000",
      "description": "Windows 98 prolonge la lignée Windows 9x avec un meilleur support du matériel, de l’USB et des usages internet, dans le contexte de la démocratisation du PC familial.",
      "group_name": "Microsoft"
    },
    {
      "name": "Office 2000",
      "years_ago": 26.92339195013116,
      "absolute_date": "1999-06-07T00:00:00.000000",
      "description": "Office 2000 pousse la collaboration web et la diffusion en réseau des documents, au moment où Microsoft cherche à adapter sa bureautique au tournant internet.",
      "group_name": "Microsoft"
    },
    {
      "name": "Windows 2000",
      "years_ago": 26.225239999412473,
      "absolute_date": "2000-02-17T00:00:00.000000",
      "description": "Windows 2000 généralise la branche NT dans le monde professionnel avec un accent sur la stabilité, l’administration centralisée et l’infrastructure d’entreprise.",
      "group_name": "Microsoft"
    },
    {
      "name": "Office XP",
      "years_ago": 24.941187980247516,
      "absolute_date": "2001-05-31T00:00:00.000000",
      "description": "Office XP prolonge l’intégration d’Office au web et aux services collaboratifs, dans le contexte de la stratégie .NET du début des années 2000.",
      "group_name": "Microsoft"
    },
    {
      "name": "Windows XP",
      "years_ago": 24.538723914539098,
      "absolute_date": "2001-10-25T00:00:00.000000",
      "description": "Windows XP fusionne enfin les lignées grand public et professionnelle autour du noyau NT. Il devient l’un des systèmes les plus durables et les plus diffusés de l’histoire de Microsoft.",
      "group_name": "Microsoft"
    },
    {
      "name": "Microsoft Office System 2003",
      "years_ago": 22.551044243081193,
      "absolute_date": "2003-10-21T00:00:00.000000",
      "description": "Office 2003 approfondit l’intégration avec SharePoint, Exchange et les flux XML d’entreprise. Il prépare le terrain de la transformation documentaire qui mènera aux formats OOXML.",
      "group_name": "Microsoft"
    },
    {
      "name": "Ecma approuve Office Open XML",
      "years_ago": 19.4216807933892,
      "absolute_date": "2006-12-07T00:00:00.000000",
      "description": "Ecma International approuve Office Open XML comme standard ECMA-376 et soumet la spécification à l’ISO. C’est une étape majeure de la bataille des formats bureautiques face à OpenDocument.",
      "group_name": "Microsoft"
    },
    {
      "name": "Windows Vista et Office 2007",
      "years_ago": 19.273836850884067,
      "absolute_date": "2007-01-30T00:00:00.000000",
      "description": "Le lancement grand public de Windows Vista et d’Office 2007 marque une refonte visuelle importante. Office 2007 introduit le ruban et généralise les formats .docx, .xlsx et .pptx.",
      "group_name": "Microsoft"
    },
    {
      "name": "OOXML approuvé pour enregistrement ISO",
      "years_ago": 18.096561012417265,
      "absolute_date": "2008-04-04T00:00:00.000000",
      "description": "Le processus ISO franchit une étape décisive quand le DIS d’OOXML est approuvé pour enregistrement comme FDIS. Cet épisode reste l’un des plus controversés de l’histoire récente de la normalisation informatique.",
      "group_name": "Microsoft"
    },
    {
      "name": "Publication d’ISO/IEC 29500",
      "years_ago": 17.475068883738277,
      "absolute_date": "2008-11-17T00:00:00.000000",
      "description": "La publication d’ISO/IEC 29500 confère un statut international à Office Open XML. Les formats .docx, .xlsx et .pptx s’inscrivent désormais dans une normalisation officiellement reconnue.",
      "group_name": "Microsoft"
    },
    {
      "name": "Windows 7",
      "years_ago": 16.546937466900495,
      "absolute_date": "2009-10-22T00:00:00.000000",
      "description": "Windows 7 corrige largement l’image laissée par Vista et devient un immense succès commercial dans les entreprises comme chez les particuliers.",
      "group_name": "Microsoft"
    },
    {
      "name": "Office 2010",
      "years_ago": 15.900804681137318,
      "absolute_date": "2010-06-15T00:00:00.000000",
      "description": "Office 2010 renforce les usages web, mobiles et collaboratifs d’Office tout en consolidant la domination des formats OOXML dans l’univers Microsoft.",
      "group_name": "Microsoft"
    },
    {
      "name": "Windows 8",
      "years_ago": 13.535301601055183,
      "absolute_date": "2012-10-26T00:00:00.000000",
      "description": "Windows 8 tente de réinventer Windows autour du tactile et d’une interface unifiée PC-tablette. La réception reste contrastée, mais la version marque un tournant stratégique.",
      "group_name": "Microsoft"
    },
    {
      "name": "Office 365 Home Premium",
      "years_ago": 13.275205776277632,
      "absolute_date": "2013-01-29T00:00:00.000000",
      "description": "Le lancement d’Office 365 Home Premium matérialise la bascule d’Office vers l’abonnement côté grand public, après les premières offres cloud destinées aux organisations.",
      "group_name": "Microsoft"
    },
    {
      "name": "Office 2013",
      "years_ago": 13.275205776277632,
      "absolute_date": "2013-01-29T00:00:00.000000",
      "description": "Office 2013 accompagne la transition vers les comptes Microsoft, SkyDrive et les usages synchronisés entre appareils.",
      "group_name": "Microsoft"
    },
    {
      "name": "Windows 8.1",
      "years_ago": 12.560626720836154,
      "absolute_date": "2013-10-17T00:00:00.000000",
      "description": "Windows 8.1 corrige une partie des choix les plus contestés de Windows 8 et réintroduit plusieurs repères attendus par les utilisateurs du bureau classique.",
      "group_name": "Microsoft"
    },
    {
      "name": "Windows 10",
      "years_ago": 10.781023709200289,
      "absolute_date": "2015-07-29T00:00:00.000000",
      "description": "Windows 10 installe le modèle de « Windows as a service », avec mises à jour continues, unification multi-appareils et nouvelle cadence de livraison logicielle.",
      "group_name": "Microsoft"
    },
    {
      "name": "Office 2016",
      "years_ago": 10.630441915908023,
      "absolute_date": "2015-09-22T00:00:00.000000",
      "description": "Office 2016 pousse plus loin la coédition, l’intégration à Office 365 et les usages collaboratifs en temps réel.",
      "group_name": "Microsoft"
    },
    {
      "name": "Office 2019",
      "years_ago": 7.624281751636975,
      "absolute_date": "2018-09-24T00:00:00.000000",
      "description": "Office 2019 incarne la continuité de la licence perpétuelle à côté du modèle par abonnement, pour les clients qui ne veulent pas basculer entièrement vers Microsoft 365.",
      "group_name": "Microsoft"
    },
    {
      "name": "Windows 11",
      "years_ago": 4.59621878106887,
      "absolute_date": "2021-10-04T00:00:00.000000",
      "description": "Windows 11 ouvre une nouvelle génération de l’interface Windows, avec des exigences matérielles accrues et une continuité du modèle de mise à jour permanente.",
      "group_name": "Microsoft"
    },
    {
      "name": "Office 2021",
      "years_ago": 4.593480930281738,
      "absolute_date": "2021-10-05T00:00:00.000000",
      "description": "Office 2021 maintient une offre bureautique sous licence perpétuelle à un moment où Microsoft privilégie déjà largement Microsoft 365.",
      "group_name": "Microsoft"
    },
    {
      "name": "Office 2024",
      "years_ago": 1.6037478707334842,
      "absolute_date": "2024-10-01T00:00:00.000000",
      "description": "Office 2024 prolonge la branche perpétuelle classique de Word, Excel, PowerPoint, OneNote et Outlook, malgré la centralité croissante du modèle Microsoft 365.",
      "group_name": "Microsoft"
    },
    {
      "name": "Windows Me et MS-DOS 8.0",
      "years_ago": 25.65029133411473,
      "absolute_date": "2000-09-14T00:00:00.000000",
      "description": "Windows Me constitue l’ultime grande version grand public encore héritière de la base DOS. Avec MS-DOS 8.0 en arrière-plan, il ferme pratiquement l’histoire du DOS dans les systèmes Microsoft destinés au grand public.",
      "group_name": "Microsoft"
    }
