    {
      "name": "Big Bang",
      "years_ago": 13800000000.0,
      "absolute_date": null,
      "description": "Évènement initial à l'origine de l'univers observable. À t = 0, l'espace-temps émerge d'un état de densité et de température extrêmes.",
      "group_name": "Astronomie & Cosmos"
    },
    {
      "name": "Inflation cosmique",
      "years_ago": 13800000000.0,
      "absolute_date": null,
      "description": "Vers 10⁻³⁶ s après le Big Bang, l'univers connaît une expansion exponentielle qui multiplie sa taille d'un facteur ~10²⁶ en une fraction de seconde, lissant les inhomogénéités primordiales.",
      "group_name": "Astronomie & Cosmos"
    },
    {
      "name": "Brisure électrofaible",
      "years_ago": 13800000000.0,
      "absolute_date": null,
      "description": "Vers 10⁻¹² s, séparation des interactions électromagnétique et faible. Acquisition de masse par les particules via le mécanisme de Higgs.",
      "group_name": "Astronomie & Cosmos"
    },
    {
      "name": "Confinement des quarks",
      "years_ago": 13800000000.0,
      "absolute_date": null,
      "description": "À t ≈ 10⁻⁶ s, les quarks et gluons forment les premiers protons et neutrons (transition QCD).",
      "group_name": "Astronomie & Cosmos"
    },
    {
      "name": "Annihilation matière / antimatière",
      "years_ago": 13800000000.0,
      "absolute_date": null,
      "description": "Vers 1 s, l'asymétrie primordiale (~1 part sur 10⁹) laisse subsister la matière qui constitue aujourd'hui l'univers.",
      "group_name": "Astronomie & Cosmos"
    },
    {
      "name": "Nucléosynthèse primordiale",
      "years_ago": 13800000000.0,
      "absolute_date": null,
      "description": "Entre 1 s et ~20 min, formation des noyaux légers : ~75 % d'hydrogène, ~25 % d'hélium-4, traces de deutérium, hélium-3 et lithium-7.",
      "group_name": "Astronomie & Cosmos"
    },
    {
      "name": "Recombinaison / fond diffus cosmologique (CMB)",
      "years_ago": 13799620000.0,
      "absolute_date": null,
      "description": "380 000 ans après le Big Bang, l'univers refroidit (~3000 K) et les électrons se lient aux noyaux : les photons se découplent et forment le CMB observable aujourd'hui à 2,725 K.",
      "group_name": "Astronomie & Cosmos"
    },
    {
      "name": "Premières étoiles (Population III)",
      "years_ago": 13600000000.0,
      "absolute_date": null,
      "description": "Vers 100-200 Ma après le Big Bang, les premières étoiles s'allument. Massives (10-1000 M☉), pauvres en métaux, à courte durée de vie : elles enrichissent l'univers en éléments lourds par leur explosion en supernova.",
      "group_name": "Astronomie & Cosmos"
    },
    {
      "name": "Premières galaxies",
      "years_ago": 13500000000.0,
      "absolute_date": null,
      "description": "Formation des premières proto-galaxies par effondrement gravitationnel du gaz primordial autour de halos de matière noire.",
      "group_name": "Astronomie & Cosmos"
    },
    {
      "name": "Formation de la Voie Lactée",
      "years_ago": 13500000000.0,
      "absolute_date": null,
      "description": "Effondrement et fusions successives donnant naissance à notre galaxie. Les plus anciennes étoiles du halo galactique datent d'environ 13,5 Ga.",
      "group_name": "Astronomie & Cosmos"
    },
    {
      "name": "Premiers quasars",
      "years_ago": 13200000000.0,
      "absolute_date": null,
      "description": "Trous noirs supermassifs en accrétion intense au centre des jeunes galaxies, parmi les objets les plus lumineux de l'univers primordial.",
      "group_name": "Astronomie & Cosmos"
    },
    {
      "name": "Réionisation cosmique",
      "years_ago": 12900000000.0,
      "absolute_date": null,
      "description": "Le rayonnement UV des premières étoiles et quasars réionise l'hydrogène neutre intergalactique entre 500 Ma et 1 Ga après le Big Bang.",
      "group_name": "Astronomie & Cosmos"
    },
    {
      "name": "Pic de formation stellaire cosmique",
      "years_ago": 10000000000.0,
      "absolute_date": null,
      "description": "Vers z ≈ 2 (il y a ~10 Ga), l'univers atteint son taux maximal de formation d'étoiles, environ 10× le taux actuel.",
      "group_name": "Astronomie & Cosmos"
    },
    {
      "name": "Formation du disque épais de la Voie Lactée",
      "years_ago": 8800000000.0,
      "absolute_date": null,
      "description": "Période de formation rapide d'étoiles donnant naissance au disque épais galactique, riche en éléments alpha.",
      "group_name": "Astronomie & Cosmos"
    },
