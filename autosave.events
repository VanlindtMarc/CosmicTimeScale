  "events": [
    {
      "name": "Formation du Soleil",
      "years_ago": 4600000000.0,
      "absolute_date": null,
      "description": "Allumage des réactions de fusion hydrogène → hélium au cœur du proto-Soleil. Le Soleil entre sur la séquence principale avec ~70 % de sa luminosité actuelle.",
      "group_name": "Astronomie & Cosmos"
    },
    {
      "name": "Première observation au télescope (Galilée)",
      "years_ago": 416.3304790949286,
      "absolute_date": "1610-01-07T00:00:00.000000",
      "description": "En 1609, Galilée pointe sa lunette vers le ciel et découvre les cratères lunaires, les phases de Vénus et les satellites de Jupiter, bouleversant la cosmologie.",
      "group_name": "Astronomie & Cosmos"
    },
    {
      "name": "Loi de Hubble",
      "years_ago": 97.15457218185537,
      "absolute_date": "1929-03-15T00:00:00.000000",
      "description": "En 1929, Edwin Hubble établit que les galaxies s'éloignent à une vitesse proportionnelle à leur distance : preuve observationnelle de l'expansion de l'univers.",
      "group_name": "Astronomie & Cosmos"
    },
    {
      "name": "Spoutnik 1",
      "years_ago": 68.59656669347856,
      "absolute_date": "1957-10-04T19:28:34.000000",
      "description": "Le 4 octobre 1957, l'URSS place en orbite le premier satellite artificiel. Début de l'ère spatiale et de la course à l'espace.",
      "group_name": "Astronomie & Cosmos"
    },
    {
      "name": "Premier homme dans l'espace (Gagarine)",
      "years_ago": 65.077214588122,
      "absolute_date": "1961-04-12T06:07:00.000000",
      "description": "Le 12 avril 1961, Iouri Gagarine effectue le premier vol orbital habité à bord de Vostok 1.",
      "group_name": "Astronomie & Cosmos"
    },
    {
      "name": "Première exoplanète (51 Pegasi b)",
      "years_ago": 30.594681695886855,
      "absolute_date": "1995-10-06T00:00:00.000000",
      "description": "En 1995, Mayor et Queloz détectent la première exoplanète autour d'une étoile semblable au Soleil. Prix Nobel de physique 2019.",
      "group_name": "Astronomie & Cosmos"
    },
    {
      "name": "Détection des ondes gravitationnelles",
      "years_ago": 10.653791228931192,
      "absolute_date": "2015-09-14T09:50:45.000000",
      "description": "Le 14 septembre 2015, LIGO observe pour la première fois directement des ondes gravitationnelles produites par la fusion de deux trous noirs.",
      "group_name": "Astronomie & Cosmos"
    },
    {
      "name": "Première image d'un trou noir",
      "years_ago": 7.083273984273804,
      "absolute_date": "2019-04-10T13:00:00.000000",
      "description": "Le 10 avril 2019, l'Event Horizon Telescope publie la première image directe du trou noir supermassif au centre de M87.",
      "group_name": "Astronomie & Cosmos"
    },
    {
      "name": "Apparition des océans",
      "years_ago": 4400000000.0,
      "absolute_date": null,
      "description": "Refroidissement de la croûte permettant la condensation de la vapeur d'eau atmosphérique en océans liquides.",
      "group_name": "Géologie & Terre"
    },
    {
      "name": "Plus anciennes roches connues",
      "years_ago": 4030000000.0,
      "absolute_date": null,
      "description": "Gneiss d'Acasta (Canada), datés à environ 4 Ga, témoignent de l'existence d'une croûte continentale stabilisée.",
      "group_name": "Géologie & Terre"
    },
    {
      "name": "Formation de la Pangée",
      "years_ago": 335000000.0,
      "absolute_date": null,
      "description": "Tous les continents se sont rassemblés en un supercontinent unique, la Pangée, entouré du super-océan Panthalassa.",
      "group_name": "Géologie & Terre"
    },
    {
      "name": "Fragmentation de la Pangée",
      "years_ago": 175000000.0,
      "absolute_date": null,
      "description": "Au Jurassique, la Pangée commence à se fragmenter en Laurasia (nord) et Gondwana (sud), donnant naissance à la disposition continentale moderne.",
      "group_name": "Géologie & Terre"
    },
    {
      "name": "Dernier maximum glaciaire",
      "years_ago": 26000.0,
      "absolute_date": null,
      "description": "Apogée de la dernière période glaciaire : calottes glaciaires couvrant l'Amérique du Nord et l'Eurasie, niveau marin ~120 m plus bas qu'aujourd'hui.",
      "group_name": "Géologie & Terre"
    },
    {
      "name": "Grande Oxydation",
      "years_ago": 2400000000.0,
      "absolute_date": null,
      "description": "Accumulation d'oxygène libre dans l'atmosphère, transformant la biosphère et provoquant la première extinction massive (anaérobies).",
      "group_name": "Évolution biologique"
    },
    {
      "name": "Premières cellules eucaryotes",
      "years_ago": 2100000000.0,
      "absolute_date": null,
      "description": "Émergence par endosymbiose entre archées et bactéries (mitochondries, puis chloroplastes chez les algues).",
      "group_name": "Évolution biologique"
    },
    {
      "name": "Faune d'Édiacara",
      "years_ago": 600000000.0,
      "absolute_date": null,
      "description": "Premiers grands organismes pluricellulaires complexes, à corps mou, découverts dans les collines d'Ediacara en Australie.",
      "group_name": "Évolution biologique"
    },
    {
      "name": "Premières plantes terrestres",
      "years_ago": 470000000.0,
      "absolute_date": null,
      "description": "Colonisation des terres émergées par les premières plantes (mousses, lichens), créant les premiers sols.",
      "group_name": "Évolution biologique"
    },
    {
      "name": "Premiers tétrapodes (Tiktaalik)",
      "years_ago": 375000000.0,
      "absolute_date": null,
      "description": "Transition des poissons à nageoires charnues vers les premiers vertébrés terrestres au Dévonien.",
      "group_name": "Évolution biologique"
    },
    {
      "name": "Premiers oiseaux (Archaeopteryx)",
      "years_ago": 150000000.0,
      "absolute_date": null,
      "description": "Au Jurassique supérieur, l'Archaeopteryx présente des caractères intermédiaires entre dinosaures théropodes et oiseaux modernes.",
      "group_name": "Évolution biologique"
    },
    {
      "name": "Lucy (Australopithecus afarensis)",
      "years_ago": 3200000.0,
      "absolute_date": null,
      "description": "Squelette d'australopithèque femelle découvert en 1974 à Hadar (Éthiopie), preuve de la bipédie chez les hominines.",
      "group_name": "Préhistoire humaine"
    },
    {
      "name": "Maîtrise du feu",
      "years_ago": 1000000.0,
      "absolute_date": null,
      "description": "Premières traces convaincantes d'usage contrôlé du feu (Wonderwerk, Afrique du Sud) : cuisson, protection, éclairage.",
      "group_name": "Préhistoire humaine"
    },
    {
      "name": "Sortie d'Afrique",
      "years_ago": 70000.0,
      "absolute_date": null,
      "description": "Migration majeure d'Homo sapiens hors d'Afrique, peuplant progressivement l'Eurasie, l'Australie puis les Amériques.",
      "group_name": "Préhistoire humaine"
    },
    {
      "name": "Peintures de Chauvet",
      "years_ago": 36000.0,
      "absolute_date": null,
      "description": "Plus anciennes peintures rupestres figuratives connues : lions, rhinocéros laineux, mammouths, en Ardèche (France).",
      "group_name": "Préhistoire humaine"
    },
    {
      "name": "Lascaux",
      "years_ago": 17000.0,
      "absolute_date": null,
      "description": "Grotte ornée du Périgord (France), célèbre pour ses peintures polychromes d'aurochs, chevaux et cerfs du Magdalénien.",
      "group_name": "Préhistoire humaine"
    },
    {
      "name": "Domestication du chien",
      "years_ago": 15000.0,
      "absolute_date": null,
      "description": "Premier animal domestiqué, à partir de loups gris commensaux des campements de chasseurs-cueilleurs.",
      "group_name": "Préhistoire humaine"
    },
    {
      "name": "Première écriture (Sumer)",
      "years_ago": 5200.0,
      "absolute_date": null,
      "description": "Apparition de l'écriture cunéiforme à Uruk, en Mésopotamie, pour la comptabilité administrative et religieuse.",
      "group_name": "Civilisations antiques"
    },
    {
      "name": "Pyramides de Gizeh",
      "years_ago": 4550.0,
      "absolute_date": null,
      "description": "Édification des grandes pyramides d'Égypte (Khéops, Khéphren, Mykérinos) sous la IVe dynastie.",
      "group_name": "Civilisations antiques"
    },
    {
      "name": "Code d'Hammurabi",
      "years_ago": 3776.0,
      "absolute_date": null,
      "description": "Recueil de lois babyloniennes gravé sur stèle (~1750 av. J.-C.), un des plus anciens corpus juridiques connus.",
      "group_name": "Civilisations antiques"
    },
    {
      "name": "Fondation de Rome",
      "years_ago": 2779.0,
      "absolute_date": null,
      "description": "Selon la tradition, fondation de Rome par Romulus en 753 av. J.-C. Début d'une civilisation qui dominera la Méditerranée.",
      "group_name": "Civilisations antiques"
    },
    {
      "name": "Naissance du Bouddha",
      "years_ago": 2589.0,
      "absolute_date": null,
      "description": "Naissance estimée de Siddhartha Gautama (~563 av. J.-C.), fondateur du bouddhisme.",
      "group_name": "Civilisations antiques"
    },
    {
      "name": "Mort de Socrate",
      "years_ago": 2425.0,
      "absolute_date": null,
      "description": "Condamné à boire la ciguë en 399 av. J.-C. à Athènes. Figure fondatrice de la philosophie occidentale.",
      "group_name": "Civilisations antiques"
    },
    {
      "name": "Conquêtes d'Alexandre le Grand",
      "years_ago": 2356.0,
      "absolute_date": null,
      "description": "Vers 330 av. J.-C., Alexandre crée un empire de la Grèce à l'Indus, diffusant la culture hellénistique.",
      "group_name": "Civilisations antiques"
    },
    {
      "name": "Chute de Rome",
      "years_ago": 1549.6473853235393,
      "absolute_date": "0476-09-04T00:00:00.000000",
      "description": "En 476, Odoacre dépose Romulus Augustule, dernier empereur romain d'Occident. Conventionnellement, début du Moyen Âge.",
      "group_name": "Moyen Âge"
    },
    {
      "name": "Couronnement de Charlemagne",
      "years_ago": 1225.3475906623482,
      "absolute_date": "0800-12-25T12:00:00.000000",
      "description": "Le 25 décembre 800, Charlemagne est couronné empereur d'Occident par le pape Léon III, restaurant l'idée d'empire en Europe.",
      "group_name": "Moyen Âge"
    },
    {
      "name": "Bataille de Hastings",
      "years_ago": 959.551902777338,
      "absolute_date": "1066-10-14T09:00:00.000000",
      "description": "Le 14 octobre 1066, Guillaume le Conquérant bat Harold II et conquiert l'Angleterre, transformant durablement l'île.",
      "group_name": "Moyen Âge"
    },
    {
      "name": "Magna Carta",
      "years_ago": 810.8862628047165,
      "absolute_date": "1215-06-15T12:00:00.000000",
      "description": "En 1215, le roi Jean d'Angleterre signe la Grande Charte, premier texte limitant le pouvoir royal et fondateur du droit anglo-saxon.",
      "group_name": "Moyen Âge"
    },
    {
      "name": "Peste noire",
      "years_ago": 678.594681695887,
      "absolute_date": "1347-10-01T00:00:00.000000",
      "description": "Pandémie de peste bubonique (1347-1352) qui tue 30 à 50 % de la population européenne, transformant économie et société.",
      "group_name": "Moyen Âge"
    },
    {
      "name": "Imprimerie de Gutenberg",
      "years_ago": 576.3441683488643,
      "absolute_date": "1450-01-01T00:00:00.000000",
      "description": "Vers 1450, Gutenberg invente l'imprimerie à caractères mobiles, démocratisant la diffusion des livres et des idées.",
      "group_name": "Renaissance & Modernité"
    },
    {
      "name": "Découverte de l'Amérique",
      "years_ago": 533.5645653372284,
      "absolute_date": "1492-10-12T06:00:00.000000",
      "description": "Le 12 octobre 1492, Christophe Colomb atteint les Bahamas, ouvrant l'ère des grandes découvertes et de la colonisation européenne.",
      "group_name": "Renaissance & Modernité"
    },
    {
      "name": "Réforme protestante",
      "years_ago": 508.51528402306,
      "absolute_date": "1517-10-31T12:00:00.000000",
      "description": "En 1517, Martin Luther affiche ses 95 thèses à Wittenberg, déclenchant une scission durable du christianisme occidental.",
      "group_name": "Renaissance & Modernité"
    },
    {
      "name": "Révolution copernicienne",
      "years_ago": 482.9560779997883,
      "absolute_date": "1543-05-24T00:00:00.000000",
      "description": "En 1543, Copernic publie 'De revolutionibus orbium coelestium', proposant un système héliocentrique qui bouleverse la vision du monde.",
      "group_name": "Renaissance & Modernité"
    },
    {
      "name": "Révolution française",
      "years_ago": 236.81582018550583,
      "absolute_date": "1789-07-14T17:30:00.000000",
      "description": "Prise de la Bastille (14 juillet 1789), Déclaration des droits de l'homme et du citoyen : fin de l'Ancien Régime en France.",
      "group_name": "Renaissance & Modernité"
    },
    {
      "name": "Principia Mathematica (Newton)",
      "years_ago": 338.8410882667287,
      "absolute_date": "1687-07-05T00:00:00.000000",
      "description": "En 1687, Newton publie ses lois du mouvement et de la gravitation universelle, fondation de la physique classique.",
      "group_name": "Sciences & Découvertes"
    },
    {
      "name": "Vaccination (Jenner)",
      "years_ago": 229.98414097035638,
      "absolute_date": "1796-05-14T00:00:00.000000",
      "description": "En 1796, Edward Jenner inocule la variole de la vache à un enfant : premier vaccin de l'histoire.",
      "group_name": "Sciences & Découvertes"
    },
    {
      "name": "De l'origine des espèces (Darwin)",
      "years_ago": 166.45778915653025,
      "absolute_date": "1859-11-24T00:00:00.000000",
      "description": "Publication en 1859 de la théorie de l'évolution par sélection naturelle, révolution dans les sciences du vivant.",
      "group_name": "Sciences & Découvertes"
    },
    {
      "name": "Tableau périodique (Mendeleïev)",
      "years_ago": 157.17647498815242,
      "absolute_date": "1869-03-06T00:00:00",
      "description": "Dmitri Mendeleïev présente sa classification des 63 éléments connus, prédisant l'existence de gallium, germanium, scandium.",
      "group_name": "Découvertes scientifiques"
    },
    {
      "name": "Relativité restreinte (Einstein)",
      "years_ago": 120.86162214763225,
      "absolute_date": "1905-06-30T00:00:00.000000",
      "description": "En 1905 (annus mirabilis), Einstein publie la relativité restreinte, redéfinissant espace, temps et énergie (E = mc²).",
      "group_name": "Sciences & Découvertes"
    },
    {
      "name": "Pénicilline (Fleming)",
      "years_ago": 97.6135044200484,
      "absolute_date": "1928-09-28T09:00:00",
