                  text="  Molette = zoom  Â·  Drag = dÃ©placer  Â·  Double-clic = reset",
                  style="Muted.TLabel").pack(side="left", padx=8)
        ttk.Button(ctrl, text="RÃ©initialiser zoom", style="Small.TButton",
                   command=lambda: self._timeline.reset_zoom()).pack(side="right")

