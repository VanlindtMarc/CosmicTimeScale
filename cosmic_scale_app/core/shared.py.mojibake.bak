def format_period_summary(start: float, end: float) -> str:
    duration = start - end
    if duration >= 1e9: return f"il y a {start/1e9:.2f} â†’ {end/1e9:.2f} Ga"
    if duration >= 1e6: return f"il y a {start/1e6:.1f} â†’ {end/1e6:.1f} Ma"
    if duration >= 1e3: return f"il y a {start/1e3:.1f} â†’ {end/1e3:.1f} ka"
    return f"il y a {start:.0f} â†’ {end:.0f} ans"


